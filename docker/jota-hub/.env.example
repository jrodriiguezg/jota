# Clave precompartida con la aplicacion Android JotaLink
JOTA_BRIDGE_API_KEY=tu_clave_secreta_aqui

# Puerto de exposicion en el servidor
JOTA_HUB_PORT=8765

# Parametros del modelo LLM
JOTA_LLM_MODEL=/app/models/qwen/qwen2.5-1.5b-instruct-q4_k_m.gguf
JOTA_LLM_CTX=4096
JOTA_LLM_THREADS=4

# Parametros STT (faster-whisper)
JOTA_FASTER_WHISPER_MODEL=base
JOTA_FASTER_WHISPER_COMPUTE=int8

# Music Assistant (Sincronizacion de colas y transferencia)
MUSIC_ASSISTANT_URL=http://tu-servidor:8095
MUSIC_ASSISTANT_TOKEN=tu_token_jwt_larga_duracion

# Navidrome / Subsonic
NAVIDROME_URL=https://tu-navidrome.ejemplo
NAVIDROME_USER=admin
NAVIDROME_SALT=tu_salt
NAVIDROME_TOKEN=tu_token
