<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1E1E2E"
    android:gravity="center">

    <!-- Cabecera del Widget -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Jota PC"
            android:textColor="#CBA6F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tailscale Activo"
            android:textColor="#A6ADC8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Fila de Botones Rapidos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4">

        <Button
            android:id="@+id/btn_widget_voice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Hablar"
            android:textSize="11sp"
            android:backgroundTint="#89B4FA"
            android:textColor="#11111B" />

        <Button
            android:id="@+id/btn_widget_play"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Play"
            android:textSize="11sp"
            android:backgroundTint="#A6E3A1"
            android:textColor="#11111B" />

        <Button
            android:id="@+id/btn_widget_mute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Mute"
            android:textSize="11sp"
            android:backgroundTint="#F9E2AF"
            android:textColor="#11111B" />

        <Button
            android:id="@+id/btn_widget_lock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bloquear"
            android:textSize="11sp"
            android:backgroundTint="#F38BA8"
            android:textColor="#11111B" />
    </LinearLayout>

</LinearLayout>
